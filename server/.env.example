PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/nivara

# JWT secrets -- generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access_secret_at_least_10_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_10_chars

# Web client origin (Vercel URL in production)
CLIENT_URL=http://localhost:5174

# ---- Cloudflare R2 (S3-compatible) ----
# Create a bucket, an S3 API token, and enable public access (r2.dev) or a custom domain.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=nivara
# Public base URL for reading images (r2.dev URL or custom domain), no trailing slash
R2_PUBLIC_URL=

# ---- Firebase Cloud Messaging (push) ----
# Base64 of the Firebase service-account JSON:
#   base64 -w0 service-account.json   (Linux)
#   base64 -i service-account.json    (macOS)
FIREBASE_SERVICE_ACCOUNT_B64=
